{
  "permissions": {
    "allow": [
      "Read(./.env.example)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run build)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./secrets/**)",
      "Edit(./.env)",
      "Edit(./**/.env)",
      "Edit(./.env.local)",
      "Edit(./.env.production)",
      "Bash(cat .env*)",
      "Bash(cat **/.env*)",
      "Bash(grep * .env*)",
      "Bash(head * .env*)",
      "Bash(tail * .env*)",
      "Bash(source .env*)",
      "Bash(printenv*)",
      "Bash(env)",
      "Bash(docker compose config*)",
      "Bash(docker inspect*)",
      "Bash(rm -rf*)",
      "Bash(docker compose down -v*)",
      "Bash(docker compose down --volumes*)",
      "Bash(docker volume rm*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)"
    ]
  }
}
