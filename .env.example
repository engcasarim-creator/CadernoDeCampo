# Copie este arquivo para ".env" e troque os valores.
# O arquivo .env NUNCA deve ser commitado nem lido por agentes de IA.

MYSQL_ROOT_PASSWORD=troque_esta_senha_root
MYSQL_DATABASE=caderno_campo
MYSQL_USER=caderno
MYSQL_PASSWORD=troque_esta_senha

# Use um valor longo e aleatório (ex.: openssl rand -hex 32)
JWT_SECRET=troque_por_um_segredo_longo_e_aleatorio
JWT_EXPIRES_IN=2h

# Administrador inicial (opcional). Ao subir a API, este usuário é criado (ou promovido a ADMIN se o e-mail já existir).
# A senha precisa ter 8+ caracteres com maiúscula, minúscula, número e símbolo; o CPF precisa ser válido.
ADMIN_EMAIL=admin@exemplo.com
ADMIN_NOME=Administrador
ADMIN_CPF=00000000000
ADMIN_SENHA=Troque@Esta123

# Chave PÚBLICA da Google Maps JavaScript API (mapa da tela inicial). Fica visível no navegador:
# no Google Cloud, restrinja-a por "Referenciadores HTTP" e à API "Maps JavaScript API". Vazia = mapa vira uma lista de links.
GOOGLE_MAPS_API_KEY=

# E-mail das decisões de contestação (opcional). Deixe SMTP_HOST vazio para NÃO enviar e-mail: o aviso dentro do
# sistema continua funcionando e o pedido mostra que o e-mail não foi enviado.
# Gmail: smtp.gmail.com, porta 587, SMTP_SECURE=false e uma "senha de app" (nunca a senha da conta).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Remetente exibido, ex.: Caderno de Campo <nao-responda@seudominio.com>
SMTP_FROM=
